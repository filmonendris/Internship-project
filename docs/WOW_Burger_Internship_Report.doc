ft;">Single branch details</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK)**</td></tr><tr style="background:#fafafa;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/categories`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">GET</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Public</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Categorized food groups</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK)**</td></tr><tr style="background:#ffffff;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/products`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">GET</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Public</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Filtered catalog items</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK)**</td></tr><tr style="background:#fafafa;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/products/:id`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">GET</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Public</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Single product detail</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK)**</td></tr><tr style="background:#ffffff;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/orders`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">POST</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Public</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Customer checkout transaction</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (201 Created)**</td></tr><tr style="background:#fafafa;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/orders`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">GET</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Public/Staff</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Fetch active order queue</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK)**</td></tr><tr style="background:#ffffff;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/orders/:id/status`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">PATCH</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Staff/Admin</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Update order progress</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK)**</td></tr><tr style="background:#fafafa;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/auth/login`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">POST</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Public</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Staff/Admin credential auth</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK)**</td></tr><tr style="background:#ffffff;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/auth/me`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">GET</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Authenticated</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Decoded token user profile</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK)**</td></tr><tr style="background:#fafafa;"><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">`/api/users`</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">GET</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">Superadmin</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">List staff accounts</td><td style="border:1px solid #d4d4d8; padding:6px 10px; text-align:left;">**PASS (200 OK / 401 Guard)**</td></tr></table>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">3.7 Results and Discussion</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">The completed application delivers an integrated restaurant experience:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Frontend Usability and Performance:** The client application compiles into a minified bundle (`dist/assets/index-[hash].js` ~522 KB, `index-[hash].css` ~55 KB) via Vite in ~50 seconds. Real DOM testing through headless Chrome CDP verified an initial mount time of 1.0 second with zero runtime console errors.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Order Transaction Execution:** Customer checkout submissions atomically insert master orders and multiple line items in MySQL, automatically calculating Ethiopian 15% VAT and rendering an order confirmation screen.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Operational Dashboard Visibility:** Administrative dashboards provide real-time KPI metrics, active order tracking with 15-second auto-refresh, and role-scoped permissions.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Theme and Accessibility Compliance:** The dual-theme system successfully toggles between light and dark palettes, while keyboard navigation, visible focus outlines, and ARIA labels ensure seamless operation for all users.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">3.8 Recommendations for the Identified Problems</h3>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Staging Database Deduplication:** A supervised database migration should be executed to merge duplicate branch records (merging branch 4 into branch 2) and prune test product rows.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**WebSocket Push Notifications:** Replacing the 15-second polling mechanism with WebSocket or Server-Sent Events (SSE) will provide instant order notifications to kitchen staff while minimizing network bandwidth.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Mobile Payment Gateway Integration:** Connecting Telebirr, CBE Birr, and Chapa payment webhooks will enable cashless payments at the time of checkout.</li>
<hr style="border:0; border-top:1px solid #d4d4d8; margin:14pt 0;" />
<br clear="all" style="page-break-before:always; mso-break-type:section-break" />
<h1 style="color:#e30613; font-family:Arial, sans-serif; font-size:18pt; font-weight:bold; margin-top:18pt; margin-bottom:8pt; border-bottom:2px solid #e30613; padding-bottom:4pt;">CHAPTER 4: BENEFITS GAINED FROM THE INTERNSHIP AND SELF-REFLECTION</h1>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.1 Practical Technical Skills Improvement</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">Throughout the internship, the author transitioned from academic programming to production-grade engineering:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Gained hands-on proficiency with **React 18** and modern hooks (`useState`, `useEffect`, `useCallback`, `useMemo`, `useRef`).</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Mastered asynchronous REST API engineering in **Node.js** and **Express**.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Acquired deep skills in managing relational databases with **MySQL**, writing complex joins, indexing strategies, and multi-table transactions.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Learned to apply **Tailwind CSS** and semantic CSS variables to build dynamic, accessible theming systems.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.2 Upgrading Theoretical Knowledge</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">Theoretical computer science concepts were illuminated through direct industrial application:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Gained a concrete understanding of **ACID transaction guarantees**, seeing firsthand how uncommitted transactions prevent corrupted order histories.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Deepened understanding of **asynchronous event loops** and non-blocking I/O in Node.js.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Solidified knowledge of **stateless client-server architecture**, token-based cryptography, and cryptographic password hashing algorithms.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.3 Industrial Problem-Solving Capabilities</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">Developing software in a fast-paced environment taught the author to approach technical challenges methodically:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Rather than guessing causes of runtime bugs, the author learned to utilize advanced debugging tools (such as Chrome DevTools Protocol and network request tracing) to isolate the exact line and character causing syntax errors.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Learned defensive programming techniques, including wrapping JSON parsing in try-catch guards and validating array types before invoking higher-order array methods.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.4 Team Collaboration and Playing Skills</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">Working inside the Web Application Development Team strengthened the author's collaborative engineering abilities:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Actively participated in daily agile stand-ups, effectively communicating task progress and technical dependencies.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Learned the value of clear Git commit messages, concise pull request descriptions, and collaborative peer reviews.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Developed an open, receptive attitude toward technical critique from senior developers.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.5 Leadership and Initiative Skills</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">The author was granted autonomy to lead the implementation of the customer shopping cart and accessibility features:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Took initiative to conduct an accessibility audit and implement WCAG 2.1 AA keyboard focus indicators across all interactive components.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Independently researched and implemented bundler-compatible image solutions for Leaflet map markers.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.6 Work Ethics, Professional Responsibility, and Industrial Psychology</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">The internship provided valuable exposure to professional workplace ethics:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Developed rigorous professional discipline regarding punctuality, sprint deadline commitments, and thorough task execution.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Gained an appreciation for **data confidentiality**, ensuring that database passwords, JWT secrets, and customer personal details are never exposed or committed to public version control.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Observed how senior engineers maintain composure and focus during critical debugging sessions, adopting a resilient, growth-oriented mindset.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.7 Entrepreneurship and Business Perspective</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">Working on the WOW Burger platform highlighted the profound link between software engineering and commercial viability:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Recognized that high-quality software directly drives business growth by accelerating order processing, cutting labor overhead, and enhancing customer satisfaction.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Understood the importance of building multi-tenant and branch-scoped architectures that scale effortlessly as a commercial franchise opens new retail locations.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.8 Interpersonal and Communication Skills</h3>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Learned to articulate technical trade-offs clearly to both engineering colleagues and non-technical stakeholders.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">Enhanced written technical communication through crafting clear API documentation, commit histories, and system architecture reports.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.9 Alignment with Career Goals and Professional Growth</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">This internship firmly reinforced the author's career ambition to become a professional <strong>Full-Stack Software Engineer</strong>. Experiencing the complete life cycle of an enterprise project—from requirements analysis to production bundling—provided the exact practical foundation necessary to pursue high-impact software engineering roles after graduation.</p>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.10 Evolution of Career Ambitions</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">Prior to the internship, the author viewed software development primarily through the lens of individual coding assignments. The industrial training at Enin Tech Solutions PLC transformed this perspective, inspiring the author to pursue broader expertise in <strong>Software Architecture</strong>, <strong>DevOps</strong>, and <strong>Scalable Distributed Systems</strong>.</p>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.11 Personal Reflection on the Value of the Internship</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">The industrial internship at Enin Tech Solutions PLC was an invaluable, transformative milestone in the author's academic and professional journey. It bridged the gap between theoretical university lectures and the rigorous demands of the modern technology industry, instilling genuine professional confidence.</p>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.12 Challenges Faced During the Practical Engagement</h3>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Initial Codebase Complexity:** Navigating a large, established repository with numerous interdependent modules was initially daunting, requiring dedicated time to trace data flows.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Balancing Feature Delivery with Rigorous Quality:** Meeting strict sprint deadlines while maintaining high code quality, accessible styling, and defensive validation demanded disciplined time management.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">4.13 Self-Evaluation: Personal Strengths and Areas for Continuous Improvement</h3>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Strengths:** Strong logical debugging skills, rapid learning curve for modern frameworks, disciplined adherence to coding standards, and high attention to user accessibility and data integrity.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Areas for Improvement:** Deepening expertise in automated end-to-end testing frameworks (Cypress/Playwright) and gaining greater familiarity with containerization platforms (Docker, Kubernetes).</li>
<hr style="border:0; border-top:1px solid #d4d4d8; margin:14pt 0;" />
<br clear="all" style="page-break-before:always; mso-break-type:section-break" />
<h1 style="color:#e30613; font-family:Arial, sans-serif; font-size:18pt; font-weight:bold; margin-top:18pt; margin-bottom:8pt; border-bottom:2px solid #e30613; padding-bottom:4pt;">CHAPTER 5: CONCLUSIONS AND RECOMMENDATIONS</h1>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">5.1 Overall Conclusion</h3>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">The industrial internship undertaken at <strong>Enin Tech Solutions PLC</strong> between July 4, 2026, and August 29, 2026, was successfully concluded with the complete design, implementation, and verification of the <strong>WOW Burger Restaurant Management and Digital Ordering Web Application</strong>. </p>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">The developed system provides a full-featured digital solution for the restaurant franchise:</p>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">A responsive, accessible customer interface featuring interactive OpenStreetMap branch discovery, dynamic categorized menu browsing, and a seamless checkout experience.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">An atomic, transactional backend service ensuring that multi-item food orders are committed reliably with 15% Ethiopian VAT calculations.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">A role-based administration portal empowering managers and system administrators with catalog control, account administration, and a live, auto-refreshing order processing pipeline.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">High software quality validated through automated API testing (100% pass rate across 16 routes) and clean production bundling (1,630 modules compiled in 50.93 seconds).</li>
<p style="font-size:11pt; line-height:1.5; margin-bottom:8pt; text-align:justify;">This practical experience significantly advanced the author's technical, analytical, collaborative, and ethical competencies, fully satisfying the objectives set forth by Haramaya University.</p>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">5.2 Recommendations for the Hosting Organization</h3>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Continuous University Collaboration:** It is strongly recommended that **Haramaya University maintain and expand its partnership with Enin Tech Solutions PLC** for future student internship placements. The company's structured mentorship, advanced tech stack, and professional environment make it an outstanding training ground for emerging software engineers.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Automated Testing Integration:** It is recommended that the company formalize automated unit and integration test pipelines (such as Jest or Vitest) within their CI/CD workflows to accelerate regression testing.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Cloud Storage Adoption:** For media-heavy applications like restaurant menus, transitioning from local static storage to dedicated cloud asset storage (e.g., AWS S3 or Cloudinary) will streamline client media updates.</li>
<h3 style="color:#27272a; font-family:Arial, sans-serif; font-size:12pt; font-weight:bold; margin-top:12pt; margin-bottom:4pt;">5.3 Recommendations for Improving the University Internship Program</h3>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Curriculum Alignment with Modern Full-Stack Ecosystems:** The university is encouraged to introduce dedicated laboratory modules covering modern JavaScript application architectures (React, Node.js, Express, TypeScript) and modern build tools (Vite).</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Early Git & Version Control Training:** Incorporating collaborative Git workflows and code review practices in early academic programming courses will better prepare students for industrial teamwork.</li>
<li style="margin-left:20pt; margin-bottom:3pt; font-size:11pt;">**Dedicated Industrial Preparation Seminars:** Organizing pre-internship workshops focused on industrial debugging tools, technical report writing, and professional workplace communication will enhance student readiness and confidence.</li>
<hr style="border:0; border-top:1px solid #d4d4d8; margin:14pt 0;" />
